#!/bin/sh
# Adapt script names to the selected build; retain exit-status and evidence behavior.
set -eu
cd "$(dirname "$0")/.."
mkdir -p evidence
run() {
  label="$1"
  shift
  if "$@" > "evidence/$label.log" 2>&1; then cat "evidence/$label.log";
  else result=$?; cat "evidence/$label.log"; exit "$result"; fi
}
run dependencies npm ci --ignore-scripts
# Lifecycle scripts were disabled above; restore package-owned hooks explicitly.
run testing-setup npx --no-install mp-testing setup --hooks-only
run wait-policy npx --no-install mp-testing check
run production npm run build
run browser npx --no-install playwright install chromium
# Playwright webServer must launch the production output, not a development server.
run scenarios npx --no-install playwright test
